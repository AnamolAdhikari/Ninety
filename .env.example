# Server-only football provider configuration. Never prefix these with NEXT_PUBLIC_.
FOOTBALL_PROVIDER=streamed
FOOTBALL_PROVIDER_BASE_URL=https://streamed.pk

# Authorized playback only. Production requires an operator-supplied HTTPS catalog.
FOOTBALL_STREAM_PROVIDER=configured
FOOTBALL_STREAM_CATALOG_JSON={}

# Comma-separated HTTPS origins authorized to render inside the sandboxed player.
FOOTBALL_EMBED_ORIGINS=https://authorized-player.example

# Canonical public deployment origin used by sitemap and robots metadata.
NINETY_SITE_URL=https://ninety.example

# Comma-separated hostnames allowed to request Next.js development resources over LAN.
NINETY_ALLOWED_DEV_ORIGINS=192.168.1.10
