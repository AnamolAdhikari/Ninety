# Runtime server-only football provider configuration. Never prefix these with NEXT_PUBLIC_.
FOOTBALL_PROVIDER=streamed
FOOTBALL_PROVIDER_BASE_URL=https://streamed.pk

# Optional server-only structured competition enrichment. Disabled gracefully when omitted.
FOOTBALL_COMPETITION_PROVIDER=disabled
FOOTBALL_COMPETITION_API_BASE_URL=https://api.football-data.org/v4
FOOTBALL_COMPETITION_API_TOKEN=

# Authorized playback adapter. Use configured for a private catalog or streamed for the authorized upstream adapter.
FOOTBALL_STREAM_PROVIDER=streamed
FOOTBALL_STREAM_PROVIDER_BASE_URL=https://streamed.pk
# Runtime secret when FOOTBALL_STREAM_PROVIDER=configured. Configure with `pnpm wrangler secret put`.
FOOTBALL_STREAM_CATALOG_JSON={}

# Runtime configuration: comma-separated HTTPS origins authorized by CSP frame-src.
FOOTBALL_EMBED_ORIGINS=https://embed.st

# Build-time and runtime configuration used by sitemap, robots, and canonical metadata.
NINETY_SITE_URL=https://ninety.example

# Development-only. Do not configure this on the production Worker.
NINETY_ALLOWED_DEV_ORIGINS=192.168.1.10
