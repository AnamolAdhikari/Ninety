{
  "name": "ninety",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:player": "node scripts/isolated-player/server.mjs",
    "dev:lan": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy -- --keep-vars",
    "cf:smoke": "node scripts/smoke-cloudflare.mjs",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv --include-runtime=false cloudflare-env.d.ts",
    "start": "next start",
    "start:lan": "next start --hostname 0.0.0.0",
    "lint": "eslint",
    "test": "vitest run"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "lucide-react": "^1.33.0",
    "motion": "^13.1.1",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  },
  "packageManager": "pnpm@11.19.0"
}
